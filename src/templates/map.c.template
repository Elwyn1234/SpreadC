}

int map<TYPE_MAP_POSTFIX>LookupIndex(Map<TYPE_MAP_POSTFIX> *map, <TYPE_KEY> key, char *success) {
  for(int i = 0; i < map->arrayMapNode.length; i++) {
    if (<COMPARATOR_FUNCTION_NAME>(key, map->arrayMapNode.data[i].key)) {
